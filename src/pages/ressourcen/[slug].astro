---
// GENERATED by scripts/gen-pages.mjs. Edit the design in src/designs/, not this file.
// Ressourcen articles: Markdown text below the frontmatter in src/content/ressourcen/de/.
import Base from '../../layouts/Base.astro';
import Shell from '../../designs/de/Shell.dc.html?dc';
import '../../designs/de/Shell.dc.html?dccss&lang.css';
import { ressourcenArticles } from '../../lib/content.mjs';
import { feedPath } from '../../lib/articles.mjs';
import { newsArticle } from '../../lib/schema.mjs';
import { SITE_URL, route } from '../../site.config.mjs';
export async function getStaticPaths() {
  return (await ressourcenArticles('de')).map((a) => ({ params: { slug: a.slug }, props: { a } }));
}
const lang = 'de';
const { a } = Astro.props;
const paths = { de: a.path, en: a.altPath };
const ogFile = `/og/de-ressourcen-${a.slug}.png`;
const next = a.catPath ? "Weitere X".replace('X', a.cat) : null;
---
<Base page="Ressourcen" lang={lang} paths={paths} title={`${a.title} · clearlea.se`} description={a.text} crumb={a.title} ogType="article" ogFile={ogFile} feed={feedPath(lang)} jsonLd={[newsArticle(lang, a, SITE_URL + a.visual.src)]}>
  <Shell client:load altHref={a.altPath}>
    <article class="cl-prose">
      <p class="cl-prose-meta">{a.catPath ? <a href={a.catPath}>{a.cat}</a> : a.cat}<span aria-hidden="true">·</span><time datetime={a.date}>{a.dateLabel}</time></p>
      <h1>{a.title}</h1>
      <p class="cl-article-lead">{a.text}</p>
      <figure class="cl-article-visual"><img src={a.visual.src} alt={a.visual.alt} width="1200" height="500" /></figure>
      <Fragment set:html={a.html} />
      {a.moreHref && <p><a href={a.moreHref}>Mehr erfahren →</a></p>}
      <hr />
      <p class="cl-article-foot">{next && <a href={a.catPath}>{next}</a>}<a href={route('Ressourcen', lang)}>Alle Ressourcen</a><a href={route('Gespraech', lang)}>Gespräch mit Hieronymus →</a></p>
    </article>
  </Shell>
</Base>
