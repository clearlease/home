---
// Document shell for every page: <head> metadata, fonts, structured data.
// The page body itself comes from the compiled design (src/designs/<lang>/<Page>.dc.html).
import '@fontsource/montserrat/400.css';
import '@fontsource/montserrat/500.css';
import '@fontsource/montserrat/600.css';
import '@fontsource/montserrat/700.css';
import '../styles/enhance.css';
import { existsSync } from 'node:fs';
import { SITE_URL, ROUTES, route } from '../site.config.mjs';
import { TITLES, DESCRIPTIONS, LABELS } from '../seo.mjs';

interface Props {
  page: string;
  lang: 'de' | 'en' | 'fr';
  description?: string;
  faq?: { q: string; a: string }[];
  jsonLd?: object[];
  noindex?: boolean;
  // Pages outside ROUTES (Ressourcen articles and filters) pass their own URLs and texts.
  // `paths` drives canonical and hreflang; `title` and `description` then win over seo.mjs.
  paths?: { de: string; en: string; fr?: string };
  title?: string;
  crumb?: string;
  ogType?: string;
  ogFile?: string;
  feed?: string;
}
const { page, lang, faq = [], jsonLd = [], noindex = false, paths, crumb, ogType = 'website', feed } = Astro.props;
const title = (paths && Astro.props.title) || (TITLES[page]?.[lang] ?? 'clearlea.se');
const description = (paths && Astro.props.description) || (DESCRIPTIONS[page]?.[lang] ?? Astro.props.description ?? '');
const abs = (p: string) => SITE_URL + p;
// Languages a page exists in: de and en everywhere, fr on the homepage only (ROUTES.Home.fr).
const own: Record<string, string> = paths ?? { de: route(page, 'de'), en: route(page, 'en'), ...(ROUTES[page]?.fr ? { fr: ROUTES[page].fr } : {}) };
const canonical = abs(own[lang]);
const deUrl = abs(own.de);
const LOCALE: Record<string, string> = { de: 'de_DE', en: 'en_GB', fr: 'fr_FR' };
// per-page link-preview image (scripts/og-images.mjs), else the generic one
const ogFile = Astro.props.ogFile ?? `/og/${lang}-${page}.png`;
const ogImage = SITE_URL + (existsSync('public' + ogFile) ? ogFile : '/og-image.png');

const ld: object[] = [...jsonLd];
// Breadcrumbs let Google show "clearlea.se › Plattform" instead of a bare URL.
if (page !== 'Home' && page !== 'NotFound' && LABELS[page]) {
  ld.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: LABELS.Home[lang], item: abs(route('Home', lang)) },
      { '@type': 'ListItem', position: 2, name: LABELS[page][lang], item: abs(route(page, lang)) },
      ...(crumb ? [{ '@type': 'ListItem', position: 3, name: crumb, item: canonical }] : []),
    ],
  });
}
if (faq.length) {
  ld.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: lang,
    mainEntity: faq.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  });
}
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && Object.entries(own).map(([l, p]) => <link rel="alternate" hreflang={l} href={abs(p)} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={deUrl} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="clearlea.se" />
    <meta property="og:locale" content={LOCALE[lang]} />
    {Object.keys(own).filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={LOCALE[l]} />)}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />
    <meta name="theme-color" content="#13293d" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="text/markdown" href="/agent.md" title="Information for AI agents" />
    {feed && <link rel="alternate" type="application/rss+xml" href={feed} title={lang === 'de' ? 'clearlea.se Ressourcen' : 'clearlea.se Resources'} />}
    <slot name="head" />
    {ld.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <slot />
    <script src="../scripts/enhance.js"></script>
  </body>
</html>
